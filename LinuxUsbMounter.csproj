<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Linux USB Mounter - .NET Framework 4.8 / C# 7.3 / WinForms, no NuGet packages.
    Build:  dotnet build -c Release      (needs the .NET SDK + .NET Framework 4.8 Developer Pack)
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>LinuxUsbMounter</RootNamespace>
    <AssemblyName>LinuxUsbMounter</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\LinuxUsbMount_v3.ico</ApplicationIcon>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <!-- a 32-bit process would be redirected away from the real wsl.exe -->
    <Prefer32Bit>false</Prefer32Bit>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningLevel>4</WarningLevel>

    <Version>2.2.0</Version>
    <Product>Linux USB Mounter</Product>
    <Description>Mount Linux and Mac formatted USB drives on Windows through WSL2</Description>
    <Company>Jay Weiner</Company>
    <Copyright>Copyright (c) 2026 Jay Weiner. MIT License with the Commons Clause: selling is not permitted.</Copyright>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <!-- System, System.Core, System.Drawing, System.Runtime.Serialization, System.Xml are implicit -->
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Management" />
  </ItemGroup>

  <ItemGroup>
    <!-- compiled separately into LinuxUsbMounter.com and the setup, see the targets below -->
    <Compile Remove="launcher\**" />
    <None Include="launcher\**" />
    <Compile Remove="installer\**" />
    <None Include="installer\**" />
  </ItemGroup>

  <ItemGroup>
    <None Include="assets\LinuxUsbMount_v3.ico" />
    <None Include="assets\LinuxUsbMount_2048_v3.png" />
    <!-- the license travels with every copy of the program (MIT notice condition, Commons Clause included) -->
    <None Include="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <!-- run inside WSL by Tools > Build filesystem drivers -->
    <None Include="tools\build-wsl-modules.sh" CopyToOutputDirectory="PreserveNewest" />
    <None Include="README.md" />
  </ItemGroup>

  <!--
    LinuxUsbMounter.com: small console front end (launcher\Launcher.cs). Terminals wait for a console
    program, so command-line output prints in order and the exit code is real. Typing the name
    without an extension picks the .com before the .exe.
  -->
  <Target Name="BuildConsoleLauncher" AfterTargets="CopyFilesToOutputDirectory"
          Inputs="launcher\Launcher.cs;$(MSBuildProjectFullPath)"
          Outputs="$(OutDir)$(AssemblyName).com">
    <Csc Sources="launcher\Launcher.cs"
         References="@(ReferencePath)"
         NoStandardLib="true"
         TargetType="exe"
         OutputAssembly="$(OutDir)$(AssemblyName).com"
         Platform="AnyCPU"
         Prefer32Bit="false"
         LangVersion="$(LangVersion)"
         Optimize="true"
         Deterministic="true"
         DebugType="none"
         Win32Icon="$(ApplicationIcon)"
         WarningLevel="4"
         ToolExe="$(CscToolExe)"
         ToolPath="$(CscToolPath)" />
    <ItemGroup>
      <FileWrites Include="$(OutDir)$(AssemblyName).com" />
    </ItemGroup>
  </Target>

  <!--
    Setup: bin\<Configuration>\LinuxUsbMounter-<Version>-Setup.exe (installer\Setup.cs), one file with the program
    embedded as "payload/..." resources. Installs to C:\Program Files\Linux_USB by default (any folder can be chosen),
    registers in Installed apps and copies itself there as Uninstall.exe. Every file the install folder gets is listed
    here: the uninstaller deletes exactly these.
  -->
  <PropertyGroup>
    <SetupExe>bin\$(Configuration)\$(AssemblyName)-$(Version)-Setup.exe</SetupExe>
    <SetupInfoFile>$(BaseIntermediateOutputPath)$(Configuration)\setup\SetupInfo.cs</SetupInfoFile>
  </PropertyGroup>
  <ItemGroup>
    <SetupPayload Include="$(OutDir)$(AssemblyName).exe" LogicalName="payload/$(AssemblyName).exe" />
    <SetupPayload Include="$(OutDir)$(AssemblyName).exe.config" LogicalName="payload/$(AssemblyName).exe.config" />
    <SetupPayload Include="$(OutDir)$(AssemblyName).com" LogicalName="payload/$(AssemblyName).com" />
    <SetupPayload Include="$(OutDir)$(AssemblyName).pdb" LogicalName="payload/$(AssemblyName).pdb" Condition="'$(DebugType)' != 'none' and '$(DebugType)' != 'embedded'" />
    <SetupPayload Include="$(OutDir)LICENSE" LogicalName="payload/LICENSE" />
    <SetupPayload Include="$(OutDir)tools\build-wsl-modules.sh" LogicalName="payload/tools/build-wsl-modules.sh" />
  </ItemGroup>
  <Target Name="BuildSetup" AfterTargets="BuildConsoleLauncher"
          Inputs="installer\Setup.cs;installer\setup.manifest;$(ApplicationIcon);@(SetupPayload);$(MSBuildProjectFullPath)"
          Outputs="$(SetupExe)">
    <WriteLinesToFile File="$(SetupInfoFile)" Overwrite="true" WriteOnlyWhenDifferent="true" Lines="
// generated by the BuildSetup target in LinuxUsbMounter.csproj%3B do not edit
[assembly: System.Reflection.AssemblyTitle(&quot;$(Product) Setup&quot;)]
[assembly: System.Reflection.AssemblyProduct(&quot;$(Product)&quot;)]
[assembly: System.Reflection.AssemblyCopyright(&quot;$(Copyright)&quot;)]
[assembly: System.Reflection.AssemblyVersion(&quot;$(Version)&quot;)]
[assembly: System.Reflection.AssemblyFileVersion(&quot;$(Version)&quot;)]
namespace LinuxUsbMounter.Setup { internal static class SetupInfo { public const string Version = &quot;$(Version)&quot;%3B } }" />
    <Csc Sources="installer\Setup.cs;$(SetupInfoFile)"
         References="@(ReferencePath)"
         Resources="@(SetupPayload)"
         NoStandardLib="true"
         TargetType="winexe"
         OutputAssembly="$(SetupExe)"
         Platform="AnyCPU"
         Prefer32Bit="false"
         LangVersion="$(LangVersion)"
         Optimize="true"
         Deterministic="true"
         DebugType="none"
         Win32Icon="$(ApplicationIcon)"
         Win32Manifest="installer\setup.manifest"
         WarningLevel="4"
         ToolExe="$(CscToolExe)"
         ToolPath="$(CscToolPath)" />
    <Message Importance="high" Text="Setup -> $(MSBuildProjectDirectory)\$(SetupExe)" />
    <ItemGroup>
      <FileWrites Include="$(SetupExe);$(SetupInfoFile)" />
    </ItemGroup>
  </Target>

  <!--
    Portable: bin\<Configuration>\LinuxUsbMounter-<Version>-Portable.zip, the same files as the setup payload (the
    whole output folder), for running without installing: extract anywhere and start LinuxUsbMounter.exe.
  -->
  <PropertyGroup>
    <PortableZip>bin\$(Configuration)\$(AssemblyName)-$(Version)-Portable.zip</PortableZip>
  </PropertyGroup>
  <Target Name="BuildPortableZip" AfterTargets="BuildSetup"
          Inputs="@(SetupPayload)" Outputs="$(PortableZip)">
    <ZipDirectory SourceDirectory="$(OutDir)" DestinationFile="$(PortableZip)" Overwrite="true" />
    <Message Importance="high" Text="Portable -> $(MSBuildProjectDirectory)\$(PortableZip)" />
    <ItemGroup>
      <FileWrites Include="$(PortableZip)" />
    </ItemGroup>
  </Target>

</Project>
