<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Xnix USB Mounter - .NET Framework 4.8 / C# 7.3 / WinForms, no NuGet packages.
    Build:  dotnet build -c Release      (needs the .NET SDK + .NET Framework 4.8 Developer Pack)
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>XnixUsbMounter</RootNamespace>
    <AssemblyName>XnixUsbMounter</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\app.ico</ApplicationIcon>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <!-- a 32-bit process would be redirected away from the real wsl.exe -->
    <Prefer32Bit>false</Prefer32Bit>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningLevel>4</WarningLevel>

    <Version>2.0.0</Version>
    <Product>Xnix USB Mounter</Product>
    <Description>Mount Linux and Mac formatted USB drives on Windows through WSL2</Description>
    <Company>Jay Weiner</Company>
    <Copyright>Copyright (c) 2026 Jay Weiner. MIT License with the Commons Clause: selling is not permitted.</Copyright>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <!-- System, System.Core, System.Drawing, System.Runtime.Serialization, System.Xml are implicit -->
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Management" />
  </ItemGroup>

  <ItemGroup>
    <!-- compiled separately into XnixUsbMounter.com, see the target below -->
    <Compile Remove="launcher\**" />
    <None Include="launcher\**" />
  </ItemGroup>

  <ItemGroup>
    <None Include="assets\app.ico" />
    <!-- the license travels with every copy of the program (MIT notice condition, Commons Clause included) -->
    <None Include="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <!-- run inside WSL by Tools > Build filesystem drivers -->
    <None Include="tools\build-wsl-modules.sh" CopyToOutputDirectory="PreserveNewest" />
    <None Include="README.md" />
  </ItemGroup>

  <!--
    XnixUsbMounter.com: small console front end (launcher\Launcher.cs). Terminals wait for a console
    program, so command-line output prints in order and the exit code is real. Typing the name
    without an extension picks the .com before the .exe.
  -->
  <Target Name="BuildConsoleLauncher" AfterTargets="CopyFilesToOutputDirectory"
          Inputs="launcher\Launcher.cs;$(MSBuildProjectFullPath)"
          Outputs="$(OutDir)$(AssemblyName).com">
    <Csc Sources="launcher\Launcher.cs"
         References="@(ReferencePath)"
         NoStandardLib="true"
         TargetType="exe"
         OutputAssembly="$(OutDir)$(AssemblyName).com"
         Platform="AnyCPU"
         Prefer32Bit="false"
         LangVersion="$(LangVersion)"
         Optimize="true"
         Deterministic="true"
         DebugType="none"
         Win32Icon="$(ApplicationIcon)"
         WarningLevel="4"
         ToolExe="$(CscToolExe)"
         ToolPath="$(CscToolPath)" />
    <ItemGroup>
      <FileWrites Include="$(OutDir)$(AssemblyName).com" />
    </ItemGroup>
  </Target>

</Project>
